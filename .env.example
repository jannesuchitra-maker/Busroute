# RouteReady Campus - Environment Configuration
# College: Malla Reddy Engineering College for Women (MRECW)

PORT=3000
NODE_ENV=development

# Bus Tracking Mode: 'simulated' (demo without real GPS hardware) or 'gps' (real driver geolocation updates)
BUS_TRACKING_MODE=simulated

# Supabase Credentials (leave blank to run in robust Local Autonomous Demonstration Mode)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT & Session Secret (used for local auth simulation fallback)
SESSION_SECRET=mrecw-routeready-campus-secure-session-key-2026

# Geolocation simulation intervals (milliseconds)
SIMULATION_INTERVAL_MS=3000
GPS_STALE_THRESHOLD_SECONDS=45

